#!/usr/bin/env bash
set -euo pipefail

log()  { echo "[update-agents] $(date '+%Y-%m-%d %H:%M:%S') $*"; }
warn() { echo "[update-agents] $(date '+%Y-%m-%d %H:%M:%S') WARN: $*"; }

log "Starting update..."

log "Upgrading brew packages (gemini-cli)..."
brew upgrade gemini-cli 2>&1 || warn "brew upgrade failed"

log "Updating claude-code (native installer)..."
claude update 2>&1 || warn "claude update failed"

# Keep the Puppeteer API used by the shared skill; npm latest is still Playwright-based.
log "Updating dev-browser..."
npm install -g dev-browser@1.0.0-rc.4 2>&1 || warn "npm install dev-browser failed"

# pi is a managed install (~/.pi/agent, from https://pi.dev/install.sh); `pi update` updates it.
# Do not install it with npm: a global npm copy lands in mise's node bin and shadows it on PATH.
log "Running pi update..."
pi update 2>&1 || warn "pi update failed"

log "Updating pi extensions..."
pi update --extensions 2>&1 || warn "pi extensions update failed"

log "Updating skills..."
npx --yes skills update -g -y 2>&1 || warn "skills update failed"

log "Done."
