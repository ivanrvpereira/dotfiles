# Local Git Configuration — machine-specific, NOT committed
# Copy to ~/.gitconfig.local and customize for this machine
# Created automatically by bootstrap.sh

# ─── Commit signing key (local filesystem) ───────────────────
# Git uses ssh-keygen by default; do not configure 1Password's op-ssh-sign here.
# [user]
# 	signingkey = ~/.ssh/git_signing_ed25519

# Work email override — loaded via includeIf in .gitconfig
# when a repo's remote matches a configured org URL pattern.
# Copy to ~/.gitconfig-work:
#
# [user]
#     email = you@company.com
