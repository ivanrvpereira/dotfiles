# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# Theme
theme = Ghostty Default Style Dark

# oh-my-posh
keybind = alt+backspace=text:\x1b\x7f

# Prevent Ctrl+T from triggering macOS "New Tab" menu action
keybind = ctrl+t=unbind

# Tab switching with cmd+function keys
keybind = cmd+f1=goto_tab:1
keybind = cmd+f2=goto_tab:2
keybind = cmd+f3=goto_tab:3
keybind = cmd+f4=goto_tab:4
keybind = cmd+f5=goto_tab:5
keybind = cmd+f6=goto_tab:6
keybind = cmd+f7=goto_tab:7
keybind = cmd+f8=goto_tab:8

# OpenSessions: Cmd+1..6 switch visible tmux/Herdr workspaces
keybind = cmd+digit_1=text:\x13\x31
keybind = cmd+1=text:\x13\x31
keybind = cmd+digit_2=text:\x13\x32
keybind = cmd+2=text:\x13\x32
keybind = cmd+digit_3=text:\x13\x33
keybind = cmd+3=text:\x13\x33
keybind = cmd+digit_4=text:\x13\x34
keybind = cmd+4=text:\x13\x34
keybind = cmd+digit_5=text:\x13\x35
keybind = cmd+5=text:\x13\x35
keybind = cmd+digit_6=text:\x13\x36
keybind = cmd+6=text:\x13\x36
#keybind = ctrl+physical:one=goto_tab:1
#keybind = ctrl+physical:two=goto_tab:2
#keybind = ctrl+physical:three=goto_tab:3
#keybind = ctrl+physical:four=goto_tab:4

keybind = ctrl+one=text:\x13\x31
keybind = ctrl+two=text:\x13\x32
keybind = ctrl+three=text:\x13\x33
keybind = ctrl+four=text:\x13\x34
keybind = ctrl+five=text:\x13\x35

# tmux/Herdr splits via Cmd+D / Cmd+Shift+D (sends Ctrl-s | and Ctrl-s -)
keybind = cmd+d=text:\x13|
keybind = cmd+shift+d=text:\x13-

# Close current tmux/Herdr pane via Cmd+W (sends Ctrl-s x)
keybind = cmd+w=text:\x13x

# tmux/vim pane navigation via Cmd+H/J/K/L (sends Ctrl+H/J/K/L)
keybind = cmd+h=text:\x08
keybind = cmd+j=text:\x0a
keybind = cmd+k=text:\x0b
keybind = cmd+l=text:\x0c

# Disable fading for non-active panels
unfocused-split-opacity = 1
split-divider-color = #FF4F00


mouse-hide-while-typing = true
cursor-style-blink = false
cursor-style = block
adjust-cursor-thickness = 200%

# don't ask when closing
confirm-close-surface = false

window-theme = system

# don't show an overlay when resizing a window
resize-overlay = never

# always save the state of window when quitting
window-save-state = always

shell-integration = fish
window-inherit-working-directory=true

font-family = "TX-02"
font-size = 13
