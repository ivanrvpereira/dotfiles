#!/usr/bin/env bash
# Worktrunk pre-start hook: link the main checkout's untracked personal files into a new worktree.
# Usage: link-local-files PRIMARY_WORKTREE NEW_WORKTREE
# Links .env (a 1Password mount: only tested for existence, never read), mise.local.toml, and every plain
# file named in .git/info/exclude (for example a personal compose.yaml). Skips tracked and existing paths.
set -euo pipefail
primary=$1
worktree=$2
[ "$primary" = "$worktree" ] && exit 0
cd "$worktree"

link() {
  local path=$1
  [ -e "$path" ] || [ -L "$path" ] && return 0
  git ls-files --error-unmatch -- "$path" >/dev/null 2>&1 && return 0
  mkdir -p "$(dirname "$path")"
  ln -s "$primary/$path" "$path"
  echo "linked $path"
}

[ -e "$primary/.env" ] && link .env
[ -f "$primary/mise.local.toml" ] && link mise.local.toml

exclude="$(git rev-parse --path-format=absolute --git-common-dir)/info/exclude"
[ -f "$exclude" ] || exit 0
while IFS= read -r pattern; do
  case $pattern in '' | '#'* | '!'* | *'*'* | *'?'* | *'['*) continue ;; esac
  pattern=${pattern#/}
  # Plain files only: directories such as node_modules or .venv must stay per worktree.
  [ -f "$primary/$pattern" ] && [ ! -L "$primary/$pattern" ] && link "$pattern"
done <"$exclude"
